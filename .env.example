# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_career_copilot"

# Auth.js / NextAuth Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET="your-auth-secret-here"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Gemini AI API Key (Server-Side Only)
# Obtain a free key from Google AI Studio at https://aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional Gemini Model identifier (verified stable model: gemini-3.5-flash)
# Default timeout per call is 45s with automatic bounded retry for transient provider demand spikes.
GEMINI_MODEL="gemini-3.5-flash"

